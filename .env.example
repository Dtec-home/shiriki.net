# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://kanisaconnect.com"

# ── Sanity CMS ───────────────────────────────────────────────────────
# Leave the project id unset locally: the app degrades gracefully to
# hardcoded fallback content when Sanity is not configured.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-01"
SANITY_API_WRITE_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# ── Transactional email (Resend) ─────────────────────────────────────
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Kanisa Connect <hello@kanisaconnect.com>"
CONTACT_TO_EMAIL="sales@kanisaconnect.com"
